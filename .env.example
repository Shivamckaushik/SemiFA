# ── LLM / Model ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                 # or leave blank when using local LLM
HF_TOKEN=hf_...                       # HuggingFace hub token for LLaVA weights
LLAVA_MODEL_ID=llava-hf/llava-v1.6-mistral-7b-hf
LLAVA_FINETUNED_PATH=./models/llava-semiconductor-qlora
DINOV2_MODEL_ID=facebook/dinov2-base

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=semiconductor_defects

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inspection-images
MINIO_SECURE=false

# ── TimescaleDB (PostgreSQL) ──────────────────────────────────────────────────
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=semiconductor_telemetry
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres

# ── MQTT (Equipment data) ─────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EQUIPMENT_TOPIC=fab/equipment/#

# ── SECS/GEM ──────────────────────────────────────────────────────────────────
SECSGEM_HOST=192.168.1.100           # Equipment HSMS IP
SECSGEM_PORT=5000
SECSGEM_SESSION_ID=1

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# ── Report output ─────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports/output
